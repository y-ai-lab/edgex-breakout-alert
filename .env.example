# Telegram BotFather token and the destination chat/group/channel ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set true to validate the scanner without sending Telegram messages.
DRY_RUN=false

# EdgeX public production endpoints.
EDGE_X_API_BASE_URL=https://edgex-prod-v2.edgex.exchange
EDGE_X_WS_URL=wss://edgex-quote-prod-v2.edgex.exchange/api/v1/public/ws

# Multi-timeframe strategy: 4H trend / roll reversal, 15M entry confirmation.
EDGE_X_MONITOR_INTERVAL=HOUR_4
EDGE_X_ENTRY_INTERVAL=MINUTE_15
EDGE_X_INTERVALS=HOUR_4,MINUTE_15

# 4H trend and role-reversal definition.
EDGE_X_TREND_FAST_EMA=20
EDGE_X_TREND_SLOW_EMA=50
EDGE_X_ROLL_LOOKBACK=20
EDGE_X_ROLL_MAX_AGE=6

# 15M pullback / rally confirmation.
EDGE_X_RETEST_LOOKBACK=4
EDGE_X_PULLBACK_SWING_LOOKBACK=5

# ATR-based stop/target adjustment.
EDGE_X_ATR_PERIOD=14
EDGE_X_ATR_STOP_BUFFER=0.5
EDGE_X_ATR_TARGET_BUFFER=0.25
EDGE_X_RETEST_ATR_TOLERANCE=0.35

# Only notify when reward/risk is at least 1:2.
# RR >= 1:3 uses equal 50/50 take-profit splitting.
EDGE_X_MIN_RR=2.0
EDGE_X_SPLIT_RR=3.0

# The strategy needs enough 4H history for EMA50 + breakout detection.
EDGE_X_HISTORY_SIZE=96
EDGE_X_ALERT_COOLDOWN_MINUTES=0

TIMEZONE=Asia/Tokyo
DATABASE_PATH=data/edgex_breakout.sqlite3
# Scheduled GitHub Actions runs use json and commit this small file back to the repo.
STATE_BACKEND=sqlite
STATE_FILE=data/edgex_alert_state.json
LOG_LEVEL=INFO


# API credentials are optional. If you do not have an EdgeX API key,
# set the current account equity manually instead.
EDGEX_EQUITY_USDC=
# Optional. If omitted, only the 5% stop-risk size is calculated.
EDGEX_AVAILABLE_BALANCE_USDC=
EDGEX_LEVERAGE=

# Optional private account read access for risk sizing.
# These are read-only account REST credentials; never commit real values.
EDGEX_ACCOUNT_ID=
EDGEX_API_KEY=
EDGEX_API_PASSPHRASE=
EDGEX_API_SECRET=

# Risk instruction shown in Telegram. 0.05 = max 5% equity loss at the ATR-adjusted SL.
EDGE_X_RISK_PER_TRADE=0.05
# EdgeX V2 default collateral coin id (USDC in the current production metadata).
EDGE_X_COLLATERAL_COIN_ID=1000
