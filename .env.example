# Telegram BotFather token and the destination chat/group/channel ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set true to validate the scanner without sending Telegram messages.
DRY_RUN=false

# EdgeX public production endpoints.
EDGE_X_API_BASE_URL=https://edgex-prod-v2.edgex.exchange
EDGE_X_WS_URL=wss://edgex-quote-prod-v2.edgex.exchange/api/v1/public/ws

# One or more supported values: MINUTE_1, MINUTE_5, MINUTE_15, HOUR_1, HOUR_4, DAY_1, ...
EDGE_X_INTERVALS=MINUTE_5

# A closed candle must close beyond the previous N-candle range.
EDGE_X_BREAKOUT_LOOKBACK=20

# The candle's EdgeX quote-currency turnover must be at least this multiple
# of the previous N-candle average turnover.
EDGE_X_VOLUME_LOOKBACK=20
EDGE_X_VOLUME_MULTIPLIER=1.5

# Minimum close-to-level distance in percent. 0.1 means 0.1%.
EDGE_X_MIN_BREAKOUT_PCT=0.1
EDGE_X_MIN_VOLUME_VALUE=0

# Avoid repeated same-direction alerts for a symbol within this many minutes.
EDGE_X_ALERT_COOLDOWN_MINUTES=30

# Reload metadata and resubscribe periodically, in case EdgeX adds/removes markets.
EDGE_X_METADATA_REFRESH_SECONDS=3600
EDGE_X_INCLUDE_HIDDEN=true
EDGE_X_HISTORY_SIZE=60

TIMEZONE=Asia/Tokyo
DATABASE_PATH=data/edgex_breakout.sqlite3
# Scheduled GitHub Actions runs use json and commit this small file back to the repo.
STATE_BACKEND=sqlite
STATE_FILE=data/edgex_alert_state.json
LOG_LEVEL=INFO


# Optional private account read access for risk sizing.
# These are read-only account REST credentials; never commit real values.
EDGEX_ACCOUNT_ID=
EDGEX_API_KEY=
EDGEX_API_PASSPHRASE=
EDGEX_API_SECRET=

# Risk instruction shown in Telegram. 0.05 = max 5% equity loss at SL.
EDGE_X_RISK_PER_TRADE=0.05
# signal_candle: long=signal candle low / short=signal candle high
# breakout_level: use the broken range level itself as SL
EDGE_X_STOP_METHOD=signal_candle
EDGE_X_TP_R_MULTIPLE=2.0
# EdgeX V2 default collateral coin id (USDC in the current production metadata).
EDGE_X_COLLATERAL_COIN_ID=1000
